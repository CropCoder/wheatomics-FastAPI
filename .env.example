# WheatOmics API — copy to `.env` and fill real values.
# The app refuses to start when DB_PASSWORD is empty (fail-fast in app/core/config.py).
# NEVER commit the real .env.

APP_NAME=WheatOmics API for Ai Agent - FastAPI
DEBUG=False

# --- MySQL application credentials (all localhost-only) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=wheatomics_user
DB_PASSWORD=            # REQUIRED — no default; rotate on leak

# --- webhook (POST /api/webhook/gitee) ---
WEBHOOK_SECRET=         # must match X-Gitee-Token configured on gitee

# --- legacy CGI submission gate (blank disables) ---
CGI_SUBMISSION_PASSWORD=

# --- PrimerServer2 ---
PRIMERSERVER2_API_KEY=
