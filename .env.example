# WheatOmics API — copy to `.env` and fill real values.
# The app refuses to start when DB_PASSWORD is empty (fail-fast in app/core/config.py).
# NEVER commit the real .env.

APP_NAME=WheatOmics API for Ai Agent - FastAPI
DEBUG=False

# --- MySQL application credentials (all localhost-only) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=wheatomics_user
DB_PASSWORD=            # REQUIRED — no default; rotate on leak

# --- webhook (POST /api/webhook/gitee) ---
WEBHOOK_SECRET=         # must match X-Gitee-Token configured on gitee

# --- legacy CGI submission gate (blank disables) ---
CGI_SUBMISSION_PASSWORD=

# --- PrimerServer2 (PCR primer design) ---
# Optional gate on the write endpoints: when set, they require X-API-Key.
PRIMERSERVER2_API_KEY=

# This module has no config file. Tool paths and job limits live in
# app/core/config.py with working defaults — PRIMERSERVER2_SAMTOOLS, _PRIMER3,
# _BLASTN, _MAKEBLASTDB, _BLASTDBCMD, _USE_CPU, _LIMIT_SITE, _LIMIT_PRIMER,
# _LIMIT_DATABASE, _SHOW_INFO, _REMOVE_TMP — override them here if this host
# puts the tools somewhere else. GET /api/PrimerServer2/health reports whether
# each tool is actually runnable.
